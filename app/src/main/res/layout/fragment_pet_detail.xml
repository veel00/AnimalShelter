<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Верхний блок с фоном и эмодзи -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="#FFCC80">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="242dp"
                    android:background="@drawable/bg_gradient_header" />

                <TextView
                    android:id="@+id/tvEmoji"
                    android:textSize="140sp"
                    android:text="🐐"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_coins"
                    android:elevation="4dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="💰 500"
                    android:textColor="#5D4037"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Карточка с именем -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="-32dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvName"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#3E2723"
                        android:text="Муся"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvType"
                        android:textSize="15sp"
                        android:textColor="#8D6E63"
                        android:layout_marginTop="4dp"
                        android:text="🐐 Козочка"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="✏️ нажми на имя, чтобы изменить"
                        android:textSize="11sp"
                        android:textColor="#A1887F"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Блок параметров -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Голод -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="🍖"
                            android:textSize="22sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Голод"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#5D4037"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvHunger"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#E65100"
                            android:text="50/100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbHunger"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="#FF9800"
                        android:progressBackgroundTint="#FFE0B2"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"/>

                    <!-- Здоровье -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="❤️"
                            android:textSize="22sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Здоровье"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#5D4037"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvHealth"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#C62828"
                            android:text="100/100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbHealth"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#EF5350"
                        android:progressBackgroundTint="#FFCDD2"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"/>

                    <!-- Настроение -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="😊"
                            android:textSize="22sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Настроение"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#5D4037"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvMood"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:text="60/100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbMood"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:max="100"
                        android:progress="60"
                        android:progressTint="#66BB6A"
                        android:progressBackgroundTint="#C8E6C9"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Кнопки действий -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:text="Действия"
                android:textColor="#5D4037"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFeed"
                    android:text="🍖 Покормить"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#FF9800"
                    app:cornerRadius="16dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeal"
                    android:text="💊 Лечить"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#EF5350"
                    app:cornerRadius="16dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                android:text="🎾 Играть"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                app:backgroundTint="#66BB6A"
                app:cornerRadius="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Кнопка "Пристроить" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdopt"
                android:text="🏠 Пристроить в семью"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                app:backgroundTint="#43A047"
                app:cornerRadius="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Контейнер для анимации сердечек -->
    <FrameLayout
        android:id="@+id/heartsContainer"
        android:layout_width="match_parent"
        android:layout_height="763dp"
        android:clickable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
